[global]
    follow = mouse
    width = (0, 350)
    height = 100
    origin = top-right
    offset = 20x20
    notification_limit = 5
    font = Sans 10
    corner_radius = 8
    border_size = 0
    padding = 10
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 0
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes

[urgency_low]
    background = "#1e66f5"
    foreground = "#ffffff"
    timeout = 3

[urgency_normal]
    background = "#1e66f5"
    foreground = "#ffffff"
    timeout = 3

[urgency_critical]
    background = "#40a02b"
    foreground = "#ffffff"
    timeout = 5