map <enter> open
map D delete
map <esc> exit
set hidden true
set ratios 1:2:3
cmd open &$xdg-open "$f"
cmd open ${{
    case $(file --mime-type -Lb "$f") in
        text/*) $EDITOR "$f" ;;
        video/*|audio/*) vlc "$f" >/dev/null 2>&1 & ;;
        *) xdg-open "$f" >/dev/null 2>&1 & ;;
    esac
}}
